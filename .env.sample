# Copy to `.env` beside docker-compose.yml and edit. Compose reads it
# automatically; `.env` is gitignored so your password stays out of the repo.
#
#   cp .env.sample .env
#
# Every value here is optional — the defaults shown are what you get if the
# line is missing or left blank.


# ---------------------------------------------------------------------------
# Host password
# ---------------------------------------------------------------------------
# Gates /new and room creation, so a stranger who finds the server cannot spawn
# sessions. It does NOT gate joining or voting — the audience needs nothing.
#
# Leave blank and a readable password is generated at every startup and printed
# to the log. That is safe, but it changes on each restart, so set your own for
# anything you run more than once:
#
#   docker compose logs interactive-scenario | grep -A3 "ADMIN PASSWORD"
ADMIN_PASSWORD=


# ---------------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------------
# Usually leave this blank. Links are derived from the address each request
# arrives on, so browsing to http://192.168.1.149:8880 gives LAN links, and
# reaching the server through Cloudflare gives public ones — the proxy forwards
# X-Forwarded-Host and X-Forwarded-Proto and the server honours both.
#
# Set it only when the address the audience uses differs from the one the
# server can see. Include the scheme; a bare hostname is assumed to be https,
# but being explicit is clearer:
#
#   PUBLIC_URL=https://interact.scurrycat.ca
PUBLIC_URL=


# ---------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------
# How long an idle room survives before it is swept. Rooms are kept in memory
# and on disk, so this only affects abandoned sessions.
ROOM_TTL_MINUTES=240

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
