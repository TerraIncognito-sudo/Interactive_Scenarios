# Copy to `.env` beside docker-compose.yml and edit. Compose reads it
# automatically; `.env` is gitignored so your password stays out of the repo.
#
#   cp .env.sample .env
#
# Every value here is optional — the defaults shown are what you get if the
# line is missing or left blank.
#
# There is deliberately nothing here for a relay key. Keys are issued and
# revoked one at a time in the console at /keys and live in the database, so
# one can be taken back from one machine without locking out every other. A
# phrase written in this file could only ever be changed for everybody at once.


# ---------------------------------------------------------------------------
# Console password
# ---------------------------------------------------------------------------
# Gates /status and /keys — watching and ending live rooms, and issuing and
# revoking the keys that let a client open one. It does NOT gate joining or
# voting: the audience needs nothing but a room code.
#
# Leave blank and a readable password is generated at every startup and printed
# to the log. That is safe, but it changes on each restart, so set your own for
# anything you run more than once:
#
#   docker compose logs interactive-scenario | grep -A3 "ADMIN PASSWORD"
ADMIN_PASSWORD=


# ---------------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------------
# Usually leave this blank. Join links are derived from the address each
# request arrives on, so browsing to http://192.168.1.149:8880 gives LAN links,
# and reaching the relay through Cloudflare gives public ones — the proxy
# forwards X-Forwarded-Host and X-Forwarded-Proto and the relay honours both.
# That is also what makes the offline fallback free: bring this container up on
# the presenting laptop, point the client at its LAN address, and the phones on
# the venue wifi get links that work with nothing configured.
#
# Set it only when the address the audience uses differs from the one the relay
# can see. Include the scheme; a bare hostname is assumed to be https, but
# being explicit is clearer:
#
#   PUBLIC_URL=https://interact.scurrycat.ca
PUBLIC_URL=


# ---------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------
# How long an idle room survives before it is swept. A room outlives the client
# that opened it on purpose — that is what lets a laptop crash mid-show and
# come back to the same code — so this is the only thing that ever tidies one
# up besides the End button.
ROOM_TTL_MINUTES=240

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
