{
  "name": "interactive-scenario",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autoplaying interactive presentation engine with live audience voting",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server/index.ts",
    "start": "node src/server/index.ts",
    "local": "node src/server/index.ts --local",
    "build": "vite build",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "node src/scenario/validate.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
